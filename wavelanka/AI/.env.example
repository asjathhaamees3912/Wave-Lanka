# Gemini / Google API keys (at least one required for chat agent)
GOOGLE_API_KEY_A=your_key_here
GOOGLE_API_KEY_B=your_key_here
# GEMINI_API_KEY=your_key_here

# Railway service URLs (no trailing slash, no quotes)
# Backend public URL — used by AI tools to call marine/weather/safety APIs
BACKEND_URL=https://YOUR-BACKEND.up.railway.app

# This AI service's own public URL — used for internal ML predict/forecast calls
AI_BASE_URL=https://YOUR-AI.up.railway.app

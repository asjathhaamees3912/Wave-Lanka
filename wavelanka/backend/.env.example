PORT=5000
CACHE_TTL_SECONDS=600
MARINE_API_URL=https://marine-api.open-meteo.com/v1/marine
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
MET_DEPT_URL=https://meteo.gov.lk

# Railway frontend public URL (CORS). Use either ALLOWED_ORIGIN or FRONTEND_URL.
# For multiple origins, set ALLOWED_ORIGINS as a comma-separated list.
ALLOWED_ORIGIN=https://YOUR-FRONTEND.up.railway.app
FRONTEND_URL=https://YOUR-FRONTEND.up.railway.app
# ALLOWED_ORIGINS=https://YOUR-FRONTEND.up.railway.app,https://your-custom-domain.com
